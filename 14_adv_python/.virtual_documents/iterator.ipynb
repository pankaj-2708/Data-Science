


import sys

# iterator loads only one item in memory at a time
l=[i for i in range(1,100000)]
print(sys.getsizeof(l))

# range is an iterable which generates an iterator
l2=range(1,100000)
print(sys.getsizeof(l2))



l=[1,2,3]
# there is __iter__ in l so it is an iterable
print(dir(l))


iter_obj=iter(l)
# there is __iter__ and __next__ in iter_obj so it is an iterator
print(dir(iter_obj))


iter_obj2=iter(iter_obj)
# iterator iter object return itself
print(id(iter_obj),id(iter_obj2))


print(next(iter_obj))
print(next(iter_obj))
print(next(iter_obj))
print(next(iter_obj))


# creating my own for loop

def my_for_loop(l):
    iterator=iter(l)
    while True:
        try:
            print(next(iterator))
        except   StopIteration:
             return


my_for_loop(l)


# range function returns all element between start and end
# our own range class

# range is an iterable -> it must have __iter__
class my_range:
    def __init__(self,start,end):
        self.start=start
        self.end=end

    def __iter__(self):
        return my_range_iterator(self)

# my_range_iterator  is an iterator -> it must have __next__ and __iter__
class my_range_iterator:
    def __init__(self,iterable):
        self.iterable=iterable

    def __iter__(self):
        return self

    def __next__(self):
        if self.iterable.start>=self.iterable.end:
            raise StopIteration
        else:
            self.iterable.start+=1
            return self.iterable.start-1


for i in my_range(1,10):
    print(i)



